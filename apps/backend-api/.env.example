PORT=8080
DB_PATH=./data/sovereign.db
PAYLOAD_SECRET_KEY=your-super-secret-hmac-key-min-32-chars
# Optional: set this to persist JWT signing key across server restarts.
# If not set, an ephemeral ECDSA key is generated and logged on startup.
# ECDSA_PRIVATE_KEY_PEM=<base64url-encoded-DER-EC-private-key>

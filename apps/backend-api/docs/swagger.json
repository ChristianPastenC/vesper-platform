                }
            }
        },
        "internal_handler_http.SyncResult": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "receiptHash": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "transactionId": {
                    "type": "string"
                }
            }
        },
        "internal_handler_http.SyncTransaction": {

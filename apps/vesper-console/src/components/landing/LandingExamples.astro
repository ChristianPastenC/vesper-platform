---
import { Code } from 'astro:components';

const example1 = `import { SovereignClientCore, FetchAdapter } from '@vesper-core/ghost-ledger';
import NetInfo from '@react-native-community/netinfo';

const client = SovereignClientCore.getInstance({
  cryptoProvider: myQuickCryptoProvider,
  networkResolver: async () => (await NetInfo.fetch()).isConnected ?? false,
  networkAdapter: new FetchAdapter(),
  defaultTTL: 60000
});

// Trapped in C++ RAM if network drops
const res = client.executeRequest('tx_101', {
  method: 'POST', url: '/v1/ledger', body: myPayload
});

// Synchronous replay after reconnection
await client.processSynchronizedQueue(async () => true);`;

const example2 = `import { SovereignClientCore, AxiosAdapter } from '@vesper-core/ghost-ledger';
import axios from 'axios';
import NetInfo from '@react-native-community/netinfo';

const client = SovereignClientCore.getInstance({
  cryptoProvider: myQuickCryptoProvider,
  networkResolver: async () => (await NetInfo.fetch()).isConnected ?? false,
  networkAdapter: new AxiosAdapter({ axiosInstance: axios.create() }),
  errorTrapping: { freezeOn503_504: true }
});

client.executeRequest('tx_102', { 
  method: 'POST', 
  url: '/api/ledger/degraded', 
  body: myPayload 
});`;

const example3 = `import { SovereignClientCore, FetchAdapter } from '@vesper-core/ghost-ledger';
import NetInfo from '@react-native-community/netinfo';

const client = SovereignClientCore.getInstance({
  cryptoProvider: myQuickCryptoProvider,
  networkResolver: async () => (await NetInfo.fetch()).isConnected ?? false,
  networkAdapter: new FetchAdapter()
});

client.executeRequest('tx_103', { 
  method: 'GET', 
  url: 'https://api.vesper.local/v1/data' 
});`;

const example4 = `import { SovereignClientCore, GraphQLAdapter } from '@vesper-core/ghost-ledger';
import NetInfo from '@react-native-community/netinfo';

const client = SovereignClientCore.getInstance({
  cryptoProvider: myQuickCryptoProvider,
  networkResolver: async () => (await NetInfo.fetch()).isConnected ?? false,
  networkAdapter: new GraphQLAdapter({ 
    endpoint: 'https://api.vesper.local/graphql' 
  })
});

client.executeRequest('tx_104', {
  method: 'POST',
  url: '',
  body: new TextEncoder().encode(JSON.stringify({ 
    query: 'mutation { createTx(amount: 1500) }' 
  }))
});`;
---

<div class="border-t border-slate-800 pt-20 mb-20">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="text-center max-w-4xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-white mb-6" data-i18n="landing.examples.title">
        Ejemplos de Uso Conceptuales
      </h2>
      <div class="bg-blue-500/10 border border-blue-500/20 rounded-2xl p-5 text-left inline-block shadow-lg">
        <h3 class="text-blue-300 font-bold mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <span data-i18n="landing.examples.crypto_title">Inyección de Dependencias (CryptoProvider)</span>
        </h3>
        <p class="text-blue-200/90 text-sm leading-relaxed" data-i18n="landing.examples.crypto_desc">
          Para mantener la librería agnóstica a la arquitectura específica de React Native (Expo vs Bare), <strong>requerimos inyectar un proveedor criptográfico</strong>. Todos los ejemplos asumen que has inyectado <code>react-native-quick-crypto</code> en la propiedad <code>cryptoProvider</code> para máxima velocidad C++.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Example 1 -->
    <div class="bg-[#0d1117] border border-slate-800 rounded-xl overflow-hidden shadow-2xl flex flex-col ring-1 ring-white/5 transition-all hover:ring-white/10">
      <div class="px-4 py-3 border-b border-slate-800 bg-slate-900/50 backdrop-blur flex justify-between items-center">
        <span class="text-xs font-mono text-slate-400 font-medium" data-i18n="landing.examples.ex1">1. Setup Básico (Queue & Replay)</span>
      </div>
      <div class="p-6 overflow-x-auto flex-1 text-sm [&>pre]:!bg-transparent [&>pre]:!m-0 [&>pre]:!p-0 custom-scrollbar">
        <Code code={example1} lang="typescript" theme="github-dark" />
      </div>
    </div>

    <!-- Example 2 -->
    <div class="bg-[#0d1117] border border-slate-800 rounded-xl overflow-hidden shadow-2xl flex flex-col ring-1 ring-white/5 transition-all hover:ring-white/10">
      <div class="px-4 py-3 border-b border-slate-800 bg-slate-900/50 backdrop-blur flex justify-between items-center">
        <span class="text-xs font-mono text-slate-400 font-medium" data-i18n="landing.examples.ex2">2. Integración con Axios</span>
      </div>
      <div class="p-6 overflow-x-auto flex-1 text-sm [&>pre]:!bg-transparent [&>pre]:!m-0 [&>pre]:!p-0 custom-scrollbar">
        <Code code={example2} lang="typescript" theme="github-dark" />
      </div>
    </div>

    <!-- Example 3 -->
    <div class="bg-[#0d1117] border border-slate-800 rounded-xl overflow-hidden shadow-2xl flex flex-col ring-1 ring-white/5 transition-all hover:ring-white/10">
      <div class="px-4 py-3 border-b border-slate-800 bg-slate-900/50 backdrop-blur flex justify-between items-center">
        <span class="text-xs font-mono text-slate-400 font-medium" data-i18n="landing.examples.ex3">3. Integración con Fetch</span>
      </div>
      <div class="p-6 overflow-x-auto flex-1 text-sm [&>pre]:!bg-transparent [&>pre]:!m-0 [&>pre]:!p-0 custom-scrollbar">
        <Code code={example3} lang="typescript" theme="github-dark" />
      </div>
    </div>

    <!-- Example 4 -->
    <div class="bg-[#0d1117] border border-slate-800 rounded-xl overflow-hidden shadow-2xl flex flex-col ring-1 ring-white/5 transition-all hover:ring-white/10">
      <div class="px-4 py-3 border-b border-slate-800 bg-slate-900/50 backdrop-blur flex justify-between items-center">
        <span class="text-xs font-mono text-slate-400 font-medium" data-i18n="landing.examples.ex4">4. Integración con GraphQL</span>
      </div>
      <div class="p-6 overflow-x-auto flex-1 text-sm [&>pre]:!bg-transparent [&>pre]:!m-0 [&>pre]:!p-0 custom-scrollbar">
        <Code code={example4} lang="typescript" theme="github-dark" />
      </div>
    </div>
  </div>
  </div>
</div>

---

---

<nav
  class="h-16 border-b border-white/5 flex items-center justify-between px-6 lg:px-12 sticky top-0 bg-slate-950/80 backdrop-blur-md z-50"
>
  <div class="flex items-center gap-3">
    <span class="bg-emerald-500/10 text-emerald-400 p-1.5 rounded ring-1 ring-emerald-500/20">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="w-5 h-5"
      >
        <path
          fill-rule="evenodd"
          d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
    <span class="text-white font-bold tracking-wide">
      <span data-i18n="landing.nav.title">Sovereign SDK</span>
    </span>
  </div>

  <div class="flex gap-4 items-center">
    <!-- Switcher -->
    <div
      class="hidden sm:flex items-center gap-1 bg-black/30 p-1 rounded-xl border border-white/5 shadow-inner mr-2"
      id="landing-lang-switcher"
    >
      <button
        data-lang="es"
        class="lang-btn px-3 py-1 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-300"
      >
        ES
      </button>
      <button
        data-lang="en"
        class="lang-btn px-3 py-1 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-300"
      >
        EN
      </button>
    </div>

    <a
      href="/login"
      class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center"
      data-i18n="landing.nav.login">Login</a
    >
    <a
      href="/register"
      class="text-sm font-medium bg-white text-black hover:bg-slate-200 px-4 py-1.5 rounded-full transition-colors flex items-center"
      data-i18n="landing.nav.register">Get API Key</a
    >
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.lang-btn');

    const updateActiveState = (lang: string) => {
      btns.forEach((b) => {
        const btnLang = b.getAttribute('data-lang');
        if (btnLang === lang) {
          b.classList.add(
            'bg-blue-500/20',
            'text-blue-400',
            'shadow-[0_0_10px_rgba(59,130,246,0.2)]',
          );
          b.classList.remove('text-slate-500');
        } else {
          b.classList.remove(
            'bg-blue-500/20',
            'text-blue-400',
            'shadow-[0_0_10px_rgba(59,130,246,0.2)]',
          );
          b.classList.add('text-slate-500');
        }
      });
    };

    const i18n = (window as any).i18n;
    if (i18n) {
      updateActiveState(i18n.language.substring(0, 2));
      i18n.on('languageChanged', (lng: string) => updateActiveState(lng.substring(0, 2)));
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const lang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
        if (lang && i18n) {
          i18n.changeLanguage(lang);
          localStorage.setItem('i18nextLng', lang);
          updateActiveState(lang);
        }
      });
    });
  });
</script>

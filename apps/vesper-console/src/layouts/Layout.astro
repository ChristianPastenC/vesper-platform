---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/globals.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Sovereign Core - Support Portal" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-50 antialiased min-h-screen selection:bg-blue-500/30">
    <div
      class="fixed inset-0 z-[-1] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-slate-950 to-slate-950"
    >
    </div>
    <slot />
    <script>
      import '../i18n/config';

      const updateTexts = () => {
        const i18n = (window as any).i18n;
        if (!i18n) return;

        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key) {
            el.innerHTML = i18n.t(key);
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key) {
            el.setAttribute('placeholder', i18n.t(key));
          }
        });
      };

      document.addEventListener('DOMContentLoaded', () => {
        const i18n = (window as any).i18n;
        if (i18n) {
          i18n.on('languageChanged', updateTexts);
          // Initial run
          updateTexts();
        }
      });
    </script>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vesper Console | 404">
  <div class="min-h-screen bg-slate-950 font-sans text-slate-300 flex flex-col items-center justify-center relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-red-600/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    <h1 class="text-9xl font-black text-transparent bg-clip-text bg-gradient-to-br from-slate-100 to-slate-600 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-white mb-8">Page Not Found</h2>
    <p class="text-slate-400 mb-8 max-w-md text-center">The requested resource could not be located on the Sovereign network.</p>
    <a href="/" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg hover:-translate-y-1">
      Return to Safety
    </a>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { LogConsole } from '../components/LogConsole';
---

<Layout title="Sovereign Telemetry | Support Console">
  <main
    class="w-full h-screen bg-[#0d1117] flex flex-col font-sans overflow-hidden"
    id="app-container"
  >
    <Header activeTab="console" client:load />
    <LogConsole client:load />
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { ApiKeyManager } from '../components/dashboard/ApiKeyManager';
import { TelemetryPanel } from '../components/dashboard/TelemetryPanel';
import SecurityPosture from '../components/dashboard/SecurityPosture.astro';
---

<Layout title="Sovereign Telemetry | Developer Portal">
  <main class="w-full h-screen bg-[#0d1117] flex flex-col font-sans" id="app-container">
    <Header activeTab="dashboard" />
    <div class="w-full flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-8 relative">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] max-w-[100vw] h-[400px] bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none -z-10"
      >
      </div>

      <div class="w-full max-w-7xl mx-auto">
        <header class="mb-10 text-center md:text-left">
          <h2
            class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400"
          >
            Dashboard Overview
          </h2>
          <p class="text-slate-400 mt-2 text-sm max-w-2xl">
            Monitoree la salud e integridad criptográfica de su flota de SDKs instalados en tiempo
            real.
          </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-1 space-y-6">
            <ApiKeyManager client:load />
            <SecurityPosture />
          </div>

          <div class="lg:col-span-2 space-y-6">
            <TelemetryPanel client:load />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { ApiKeyManager } from '../components/dashboard/ApiKeyManager';
import { TelemetryPanel } from '../components/dashboard/TelemetryPanel';
import { SecurityPosture } from '../components/dashboard/SecurityPosture';
import { DashboardHeader } from '../components/dashboard/DashboardHeader';
---

<Layout title="Sovereign Telemetry | Dashboard">
  <div
    class="min-h-screen bg-slate-950 font-sans text-slate-300 selection:bg-emerald-500/30 overflow-x-hidden"
  >
    <Header activeTab="dashboard" client:load />

    <main class="max-w-7xl mx-auto px-4 md:px-8 py-8 w-full">
      <DashboardHeader client:load />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <!-- Columna Izquierda: API Keys y Postura -->
        <div class="space-y-8 lg:col-span-1">
          <ApiKeyManager client:load />
          <SecurityPosture client:load />
        </div>

        <!-- Columna Derecha: Gráficos de Telemetría -->
        <div class="lg:col-span-2">
          <TelemetryPanel client:load />
        </div>
      </div>
    </main>
  </div>
</Layout>

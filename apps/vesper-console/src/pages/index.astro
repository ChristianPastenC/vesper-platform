---
import Layout from '../layouts/Layout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingFeatures from '../components/landing/LandingFeatures.astro';
import LandingExamples from '../components/landing/LandingExamples.astro';
import LandingQuickStart from '../components/landing/LandingQuickStart.astro';
---

<Layout title="Sovereign SDK | Zero-Trust C++ Library">
  <main class="w-full min-h-screen bg-slate-950 font-sans text-slate-300 selection:bg-emerald-500/30 overflow-x-hidden">
    <LandingNavbar />
    <LandingHero />
    <LandingFeatures />
    <LandingExamples />
    <LandingQuickStart />
    
    <footer class="border-t border-slate-800 bg-slate-900 py-12 mt-20 text-center w-full">
      <p class="text-slate-500 text-sm">© 2026 Sovereign Developer Platform. B2B Dashboard.</p>
    </footer>
  </main>
</Layout>

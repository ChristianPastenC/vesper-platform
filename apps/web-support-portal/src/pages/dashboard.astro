---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Sovereign Telemetry | Developer Portal">
  <main class="h-screen bg-[#0d1117] flex flex-col font-sans hidden" id="app-container">
    
    <Header activeTab="dashboard" />

    <div class="flex-1 overflow-auto p-8">
      <div class="max-w-7xl mx-auto">
        <header class="mb-8">
          <h2 class="text-2xl font-bold text-white">Dashboard Overview</h2>
          <p class="text-slate-400 mt-1 text-sm">Monitoree la salud e integridad criptográfica de su flota de SDKs instalados.</p>
        </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Panel de Keys -->
      <div class="lg:col-span-1 space-y-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent pointer-events-none"></div>
          <h2 class="text-lg font-semibold text-white mb-4">API Keys</h2>
          <p class="text-sm text-slate-400 mb-6">Genere llaves para inyectar en la configuración de <code>SovereignClientCore</code> en el dispositivo del cliente.</p>
          
          <div id="keys-list" class="space-y-3 mb-6">
            <!-- Keys renders here -->
            <div class="animate-pulse flex space-x-4">
              <div class="flex-1 space-y-2 py-1">
                <div class="h-4 bg-slate-800 rounded w-3/4"></div>
                <div class="h-4 bg-slate-800 rounded w-1/2"></div>
              </div>
            </div>
          </div>

          <form id="create-key-form" class="space-y-3">
            <fieldset id="create-key-fieldset" class="space-y-3">
              <input type="text" name="name" placeholder="Nombre de la llave (Ej. Producción)" required
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              />
              <button type="submit" id="create-key-btn" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Generar API Key
              </button>
            </fieldset>
          </form>
        </div>
      </div>

      <!-- Panel de Telemetría -->
      <div class="lg:col-span-2 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-red-500/5 to-transparent pointer-events-none"></div>
            <h2 class="text-lg font-semibold text-white mb-2">Integridad del Ledger</h2>
            <div class="flex items-baseline gap-3 mb-6">
              <span class="text-3xl font-bold text-white" id="integrity-value">0</span>
              <span class="text-xs font-medium px-2 py-1 rounded bg-emerald-500/20 text-emerald-400" id="integrity-status">Estable</span>
            </div>
            <div class="h-48">
              <canvas id="integrityChart"></canvas>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent pointer-events-none"></div>
            <h2 class="text-lg font-semibold text-white mb-2">Latencia DPoP (ms)</h2>
            <div class="flex items-baseline gap-3 mb-6">
              <span class="text-3xl font-bold text-white" id="latency-value">0 ms</span>
              <span class="text-xs font-medium px-2 py-1 rounded bg-blue-500/20 text-blue-400" id="latency-status">Esperando datos</span>
            </div>
            <div class="h-48">
              <canvas id="latencyChart"></canvas>
            </div>
          </div>
        </div>
      </div>
      
      </div>
    </div>
  </main>
</Layout>

<script>
  import Chart from 'chart.js/auto';

  document.addEventListener('DOMContentLoaded', async () => {
    const token = localStorage.getItem('sovereign_session_token');
    if (!token) {
      window.location.href = '/login';
      return;
    }

    const appContainer = document.getElementById('app-container')!;
    appContainer.classList.remove('hidden');

    const keysList = document.getElementById('keys-list')!;
    const createKeyForm = document.getElementById('create-key-form') as HTMLFormElement;

    const renderKey = (k: any) => {
      const date = new Date(k.created_at).toLocaleDateString();
      return `
        <div class="p-4 rounded-lg border border-slate-800 bg-slate-950 flex flex-col gap-3 relative group">
          <button class="revoke-btn absolute top-3 right-3 text-red-500 hover:text-red-400 bg-red-500/10 hover:bg-red-500/20 px-2 py-1 rounded text-xs font-semibold transition-colors" data-key="${k.key}">
            Revocar
          </button>
          
          <div>
            <div class="flex justify-between items-center pr-16">
              <span class="text-sm font-bold text-white">${k.name}</span>
            </div>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-xs text-slate-500 font-mono bg-slate-900 px-1.5 py-0.5 rounded border border-slate-800">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 inline mr-1 -mt-0.5"><path fill-rule="evenodd" d="M2 3a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2Zm0 4.5h16v1.5H2v-1.5Zm0 4.5h16v1.5H2v-1.5Zm0 4.5h16V17a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1.5Z" clip-rule="evenodd" /></svg>
                ${k.bundle_id || 'Pendiente de vinculación (TOFU)'}
              </span>
              <span class="text-xs text-slate-600">${date}</span>
            </div>
          </div>
          
          <div class="bg-black/50 p-2.5 rounded flex justify-between items-center hover:ring-1 hover:ring-emerald-500/30 transition-all cursor-pointer" onclick="navigator.clipboard.writeText('${k.key}')">
            <code class="text-xs text-emerald-400 font-mono tracking-wide">${k.key}</code>
            <span class="text-slate-500 text-xs">Copiar</span>
          </div>
        </div>
      `;
    };

    const fetchKeys = async () => {
      try {
        const res = await fetch('http://127.0.0.1:8081/api/v1/b2b/keys', {
          headers: { 'Authorization': token }
        });
        if (res.status === 401) throw new Error('Unauthorized');
        const keys = await res.json();
        
        const fieldset = document.getElementById('create-key-fieldset') as HTMLFieldSetElement;
        const btn = document.getElementById('create-key-btn') as HTMLButtonElement;
        
        if (keys.length === 0) {
          keysList.innerHTML = '<p class="text-sm text-slate-500">No hay llaves generadas.</p>';
          fieldset.disabled = false;
          btn.textContent = 'Generar API Key';
        } else {
          keysList.innerHTML = keys.map(renderKey).join('');
          fieldset.disabled = true;
          btn.textContent = 'Límite alcanzado (1/1)';
          
          document.querySelectorAll('.revoke-btn').forEach(revokeBtn => {
            revokeBtn.addEventListener('click', async (e) => {
              const target = e.currentTarget as HTMLButtonElement;
              const k = target.getAttribute('data-key');
              if(confirm("¿Estás seguro que deseas revocar esta API Key? Todas las peticiones con este Bundle ID fallarán hasta configurar una nueva.")) {
                target.disabled = true;
                target.textContent = 'Revocando...';
                await fetch(`http://127.0.0.1:8081/api/v1/b2b/keys?key=${k}`, {
                  method: 'DELETE',
                  headers: { 'Authorization': token }
                });
                await fetchKeys();
              }
            });
          });
        }
      } catch (err) {
        localStorage.clear();
        window.location.href = '/login';
      }
    };

    createKeyForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createKeyForm);
      const name = formData.get('name');
      const fieldset = document.getElementById('create-key-fieldset') as HTMLFieldSetElement;
      const btn = document.getElementById('create-key-btn')!;
      
      fieldset.disabled = true;
      btn.textContent = 'Generando...';

      try {
        const r = await fetch('http://127.0.0.1:8081/api/v1/b2b/keys', {
          method: 'POST',
          headers: {
            'Authorization': token,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ name })
        });
        if (r.ok) {
          createKeyForm.reset();
        } else {
          alert('Error al generar llave (Límite alcanzado)');
        }
        await fetchKeys();
      } finally {
        // fetchKeys will re-enable if keys == 0
      }
    });

    await fetchKeys();

    // Chart.js init
    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      animation: { duration: 400 },
      scales: {
        x: { grid: { display: false, color: '#334155' }, ticks: { color: '#94a3b8', maxRotation: 45, minRotation: 45 } },
        y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } }
      }
    };

    const integrityChart = new Chart(document.getElementById('integrityChart') as HTMLCanvasElement, {
      type: 'line',
      data: { labels: [], datasets: [{ data: [], borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: true, tension: 0.4 }] },
      options: { ...commonOptions, scales: { ...commonOptions.scales, y: { ...commonOptions.scales.y, min: 0, suggestedMax: 2 } } }
    });

    const latencyChart = new Chart(document.getElementById('latencyChart') as HTMLCanvasElement, {
      type: 'line',
      data: { labels: [], datasets: [{ data: [], borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: true, tension: 0.4 }] },
      options: { ...commonOptions, scales: { ...commonOptions.scales, y: { ...commonOptions.scales.y, min: 0 } } }
    });

    // Real-time metrics polling
    const fetchMetrics = async () => {
      try {
        const res = await fetch('http://127.0.0.1:8081/api/v1/b2b/metrics', {
          headers: { 'Authorization': token }
        });
        if (!res.ok) return;
        const metrics = await res.json();
        
        const integrityData: any[] = [];
        const latencyData: any[] = [];

        metrics.forEach((m: any) => {
          const date = new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          if (m.metric_type === 1) { // Integrity
            integrityData.push({ x: date, y: m.value });
          } else if (m.metric_type === 2) { // Latency
            latencyData.push({ x: date, y: m.value });
          }
        });

        if (integrityData.length > 0) {
          integrityChart.data.labels = integrityData.map(d => d.x);
          integrityChart.data.datasets[0].data = integrityData.map(d => d.y);
          integrityChart.update('none');
          
          const latest = integrityData[integrityData.length - 1].y;
          document.getElementById('integrity-value')!.textContent = latest.toString();
          const statusEl = document.getElementById('integrity-status')!;
          if (latest > 0) {
            statusEl.textContent = 'Alerta';
            statusEl.className = 'text-xs font-medium px-2 py-1 rounded bg-red-500/20 text-red-400';
          } else {
            statusEl.textContent = 'Estable';
            statusEl.className = 'text-xs font-medium px-2 py-1 rounded bg-emerald-500/20 text-emerald-400';
          }
        }

        if (latencyData.length > 0) {
          latencyChart.data.labels = latencyData.map(d => d.x);
          latencyChart.data.datasets[0].data = latencyData.map(d => d.y);
          latencyChart.update('none');
          
          const latest = latencyData[latencyData.length - 1].y;
          document.getElementById('latency-value')!.textContent = latest.toFixed(1) + ' ms';
          const statusEl = document.getElementById('latency-status')!;
          if (latest > 100) {
            statusEl.textContent = 'Crítico';
            statusEl.className = 'text-xs font-medium px-2 py-1 rounded bg-red-500/20 text-red-400';
          } else if (latest > 50) {
            statusEl.textContent = 'Lento';
            statusEl.className = 'text-xs font-medium px-2 py-1 rounded bg-yellow-500/20 text-yellow-400';
          } else {
            statusEl.textContent = 'Óptimo';
            statusEl.className = 'text-xs font-medium px-2 py-1 rounded bg-blue-500/20 text-blue-400';
          }
        }
      } catch (err) {
        console.error("Error fetching metrics", err);
      }
    };

    // Fetch immediately and then every 3 seconds
    fetchMetrics();
    setInterval(fetchMetrics, 3000);
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import LedgerIntegrityBoard from '../components/LedgerIntegrityBoard';
---

<Layout title="Sovereign Core | Security Dashboard">
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <header class="mb-10 flex items-center justify-between border-b border-white/10 pb-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="bg-blue-500/10 text-blue-400 p-2 rounded-lg ring-1 ring-blue-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
            </svg>
          </span>
          SOC Analytics
        </h1>
        <p class="text-slate-400 mt-2 text-sm">Real-time observability and ledger integrity matrix.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <span class="text-sm font-medium text-emerald-400">System Secure</span>
      </div>
    </header>

    <LedgerIntegrityBoard client:load />
  </main>
</Layout>

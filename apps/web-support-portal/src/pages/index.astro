---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sovereign Telemetry | SaaS Preview">
  <main class="min-h-screen bg-slate-950 flex flex-col items-center justify-center p-6 relative overflow-hidden">
    
    <!-- Background effects -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-600/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-emerald-600/20 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="text-center z-10 max-w-3xl">
      <div class="mb-6 flex justify-center">
        <span class="bg-blue-500/10 text-blue-400 p-4 rounded-2xl ring-1 ring-blue-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-12 h-12">
            <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 tracking-tight mb-6">
        Sovereign Developer Platform
      </h1>
      <p class="text-lg md:text-xl text-slate-400 mb-10 leading-relaxed max-w-2xl mx-auto">
        La primera plataforma B2B de monitoreo de telemetría criptográfica y observabilidad nativa de memoria para flotas de SDKs C++. Zero-Trust. Zero-PII.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/login" class="bg-blue-600 hover:bg-blue-500 text-white font-medium py-3 px-8 rounded-full transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(37,99,235,0.4)]">
          Iniciar Sesión
        </a>
        <a href="/signup" class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-medium py-3 px-8 rounded-full transition-all hover:scale-105">
          Crear Organización
        </a>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-24 z-10 max-w-5xl w-full">
      <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl backdrop-blur-sm">
        <h3 class="text-white font-bold mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Ingesta Nativa
        </h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Estructuras binarias de 17 bytes altamente optimizadas. Consume memoria cero en el recolector de basura de JS.
        </p>
      </div>
      <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl backdrop-blur-sm">
        <h3 class="text-white font-bold mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          Latencia DPoP
        </h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Monitoriza en tiempo real los milisegundos requeridos para el cómputo del token criptográfico asimétrico en C++.
        </p>
      </div>
      <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl backdrop-blur-sm">
        <h3 class="text-white font-bold mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          Alerta de Volcados
        </h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Notificaciones inmediatas al detectar manipulación de RAM e incidentes de "Zeroization".
        </p>
      </div>
    </div>
  </main>
</Layout>

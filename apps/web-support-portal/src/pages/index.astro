---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sovereign Telemetry | Developer Portal">
  <main class="container mx-auto px-4 py-8 max-w-7xl hidden" id="app-container">
    <header class="mb-10 flex items-center justify-between border-b border-white/10 pb-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="bg-blue-500/10 text-blue-400 p-2 rounded-lg ring-1 ring-blue-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
              <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
            </svg>
          </span>
          Sovereign Developer Portal
        </h1>
        <p class="text-slate-400 mt-2 text-sm">Monitoree la salud e integridad criptográfica de su flota de SDKs instalados.</p>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <div class="text-sm font-medium text-white" id="tenant-name-display">Cargando...</div>
          <button id="logout-btn" class="text-xs text-red-400 hover:text-red-300 transition-colors">Cerrar Sesión</button>
        </div>
        <div class="h-10 w-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 ring-2 ring-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
            <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Panel de Keys -->
      <div class="lg:col-span-1 space-y-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent pointer-events-none"></div>
          <h2 class="text-lg font-semibold text-white mb-4">API Keys</h2>
          <p class="text-sm text-slate-400 mb-6">Genere llaves para inyectar en la configuración de <code>SovereignClientCore</code> en el dispositivo del cliente.</p>
          
          <div id="keys-list" class="space-y-3 mb-6">
            <!-- Keys renders here -->
            <div class="animate-pulse flex space-x-4">
              <div class="flex-1 space-y-2 py-1">
                <div class="h-4 bg-slate-800 rounded w-3/4"></div>
                <div class="h-4 bg-slate-800 rounded w-1/2"></div>
              </div>
            </div>
          </div>

          <form id="create-key-form" class="flex gap-2">
            <input type="text" name="name" placeholder="Nombre de la llave (Ej. Producción)" required
              class="flex-1 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
            />
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition-colors">
              Generar
            </button>
          </form>
        </div>
      </div>

      <!-- Panel de Telemetría -->
      <div class="lg:col-span-2 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-red-500/5 to-transparent pointer-events-none"></div>
            <h2 class="text-lg font-semibold text-white mb-2">Integridad del Ledger</h2>
            <div class="flex items-baseline gap-3 mb-6">
              <span class="text-3xl font-bold text-white">0</span>
              <span class="text-xs font-medium px-2 py-1 rounded bg-emerald-500/20 text-emerald-400">Estable</span>
            </div>
            <div class="h-48">
              <canvas id="integrityChart"></canvas>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent pointer-events-none"></div>
            <h2 class="text-lg font-semibold text-white mb-2">Latencia DPoP (ms)</h2>
            <div class="flex items-baseline gap-3 mb-6">
              <span class="text-3xl font-bold text-white">12.5 ms</span>
              <span class="text-xs font-medium px-2 py-1 rounded bg-blue-500/20 text-blue-400">Óptimo</span>
            </div>
            <div class="h-48">
              <canvas id="latencyChart"></canvas>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </main>
</Layout>

<script>
  import Chart from 'chart.js/auto';

  document.addEventListener('DOMContentLoaded', async () => {
    const token = localStorage.getItem('sovereign_session_token');
    if (!token) {
      window.location.href = '/login';
      return;
    }

    const appContainer = document.getElementById('app-container')!;
    const tenantName = localStorage.getItem('sovereign_tenant_name');
    document.getElementById('tenant-name-display')!.textContent = tenantName;
    appContainer.classList.remove('hidden');

    document.getElementById('logout-btn')!.addEventListener('click', () => {
      localStorage.clear();
      window.location.href = '/login';
    });

    const keysList = document.getElementById('keys-list')!;
    const createKeyForm = document.getElementById('create-key-form') as HTMLFormElement;

    const renderKey = (k: any) => {
      const date = new Date(k.created_at).toLocaleDateString();
      return `
        <div class="p-3 rounded-lg border border-slate-800 bg-slate-950 flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <span class="text-sm font-medium text-slate-200">${k.name}</span>
            <span class="text-xs text-slate-500">${date}</span>
          </div>
          <div class="bg-black/50 p-2 rounded flex justify-between items-center group">
            <code class="text-xs text-emerald-400 font-mono">${k.key}</code>
            <button class="text-slate-500 hover:text-white opacity-0 group-hover:opacity-100 transition-opacity" onclick="navigator.clipboard.writeText('${k.key}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M13.887 3.182c.396.037.79.08 1.183.128C16.194 3.45 17 4.414 17 5.517V16.75A2.25 2.25 0 0 1 14.75 19h-9.5A2.25 2.25 0 0 1 3 16.75V5.517c0-1.103.806-2.068 1.93-2.207.393-.048.787-.09 1.183-.128A3.001 3.001 0 0 1 9 1h2c1.373 0 2.531.923 2.887 2.182ZM7.5 4A1.5 1.5 0 0 1 9 2.5h2A1.5 1.5 0 0 1 12.5 4v.5h-5V4Z" clip-rule="evenodd" /></svg>
            </button>
          </div>
        </div>
      `;
    };

    const fetchKeys = async () => {
      try {
        const res = await fetch('http://127.0.0.1:8081/api/v1/b2b/keys', {
          headers: { 'Authorization': token }
        });
        if (res.status === 401) throw new Error('Unauthorized');
        const keys = await res.json();
        if (keys.length === 0) {
          keysList.innerHTML = '<p class="text-sm text-slate-500">No hay llaves generadas.</p>';
        } else {
          keysList.innerHTML = keys.map(renderKey).join('');
        }
      } catch (err) {
        localStorage.clear();
        window.location.href = '/login';
      }
    };

    createKeyForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createKeyForm);
      const name = formData.get('name');
      const btn = createKeyForm.querySelector('button')!;
      btn.disabled = true;
      btn.textContent = '...';

      try {
        await fetch('http://127.0.0.1:8081/api/v1/b2b/keys', {
          method: 'POST',
          headers: {
            'Authorization': token,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ name })
        });
        createKeyForm.reset();
        await fetchKeys();
      } finally {
        btn.disabled = false;
        btn.textContent = 'Generar';
      }
    });

    await fetchKeys();

    // Chart.js init
    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false, color: '#334155' }, ticks: { color: '#94a3b8' } },
        y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } }
      }
    };

    new Chart(document.getElementById('integrityChart') as HTMLCanvasElement, {
      type: 'line',
      data: {
        labels: ['10:00', '10:05', '10:10', '10:15', '10:20', '10:25'],
        datasets: [{
          data: [0, 0, 0, 0, 0, 0],
          borderColor: '#ef4444',
          backgroundColor: 'rgba(239, 68, 68, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: commonOptions
    });

    new Chart(document.getElementById('latencyChart') as HTMLCanvasElement, {
      type: 'line',
      data: {
        labels: ['10:00', '10:05', '10:10', '10:15', '10:20', '10:25'],
        datasets: [{
          data: [12.5, 13.0, 11.2, 14.1, 12.0, 12.5],
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: commonOptions
    });
  });
</script>

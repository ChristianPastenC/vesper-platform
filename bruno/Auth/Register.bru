meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testuser",
    "password": "Password123!",
    "email": "test@example.com",
    "firstName": "Test",
    "lastName": "User",
    "phone": "555-1234"
  }
}

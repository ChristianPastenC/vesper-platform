meta {
  name: Process Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/checkout/pay
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt}}

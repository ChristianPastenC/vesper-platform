    "total": 150.50,
    "card": {
      "number": "4242424242424242",
      "expMonth": "12",
      "expYear": "2026",
      "cvc": "123"
    },
    "items": [
      {
        "id": "1",
        "title": "Test Product",
        "price": 150.50,
        "quantity": 1
      }
    ]
  }
}

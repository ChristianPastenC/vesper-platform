meta {
  name: Sync Offline Payments
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/checkout/sync
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt}}
  X-Idempotency-Key: sync_test_123
}

body:json {

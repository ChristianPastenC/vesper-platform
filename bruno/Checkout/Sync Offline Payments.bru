        "payload": {
          "total": 50.0,
          "card": {
            "number": "4242424242424242",
            "expMonth": "10",
            "expYear": "2028",
            "cvc": "111"
          },
          "items": [
            {
              "id": "2",
              "title": "Offline Product",
              "price": 50.0,
              "quantity": 1
            }
          ]
        }
      }
    ]
  }
}

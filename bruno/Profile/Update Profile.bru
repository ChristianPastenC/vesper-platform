meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/profile/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "firstName": "Updated Name",
    "phone": "555-9999"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/profile/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "firstName": "Updated Name",
    "phone": "555-9999"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  const secret = bru.getEnvVar("PAYLOAD_SECRET_KEY") || "sovereign-core-secret-hmac-key-20260701";
  const body = req.getBody();
  const bodyStr = typeof body === "string" ? body : JSON.stringify(body);
  const hash = CryptoJS.HmacSHA256(bodyStr, secret).toString(CryptoJS.enc.Hex);
  req.setHeader("X-Sovereign-Hash", hash);
}

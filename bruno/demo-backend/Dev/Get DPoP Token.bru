meta {
  name: Get DPoP Token (DEV ONLY)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/dev/dpop-token
  body: json
  auth: none
}

body:json {
  {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/checkout/pay"
  }
}


script:post-response {
  if (res.status === 200 && res.body.dpopToken) {
    bru.setVar("dpopToken", res.body.dpopToken);
    req.setHeader("DPoP", res.body.dpopToken);
  }
}

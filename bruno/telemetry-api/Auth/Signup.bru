meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/b2b/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "Test Company",
    "email": "test@sovereign.local",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}

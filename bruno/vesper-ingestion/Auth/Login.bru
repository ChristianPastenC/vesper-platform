meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/b2b/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@sovereign.local",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}

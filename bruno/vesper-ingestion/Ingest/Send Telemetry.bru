meta {
  name: Send Telemetry
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/support/telemetry
  body: none
  auth: none
}

headers {
  X-Vesper-API-Key: {{api_key}}
  X-Bundle-ID: {{bundle_id}}
  X-Vesper-Session-Key: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  X-Vesper-IV: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
  X-Vesper-Start-Index: 0
}

docs {
  This sends binary telemetry. Since Bruno body configuration for raw binary might be tricky, it's easier to use curl for testing ingestion, or you can attach a binary file in the Bruno UI.
}

meta {
  name: Create Key
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/b2b/keys
  body: json
  auth: none
}

headers {
  Authorization: {{token}}
}

body:json {
  {
    "name": "Production Key"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("api_key", res.body.key);
  }
}

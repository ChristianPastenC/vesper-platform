# For Android Emulator use 10.0.2.2 instead of localhost
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Generate this key in the web-support-portal dashboard (Panel de API Keys) and
# paste it here to enable real-time telemetry ingestion. Leave empty to disable.
EXPO_PUBLIC_TELEMETRY_API_KEY=
# Optional overrides; defaults match apps/telemetry-api running locally on :8081
# and app.json's bundleIdentifier/package.
# EXPO_PUBLIC_TELEMETRY_BUNDLE_ID=mx.edu.sovereign.core
# EXPO_PUBLIC_TELEMETRY_ENDPOINT=http://10.0.2.2:8081/api/v1/support/telemetry

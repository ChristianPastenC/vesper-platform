{
  "name": "demo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "nitro": "react-native nitrogen",
    "start": "react-native start --port 8082",
    "start:clear": "react-native start --reset-cache --port 8082",
    "android": "react-native run-android --port 8082",
    "android:clean": "cd android && (gradlew clean || ./gradlew clean)",
    "android:studio": "echo \"Para abrir en Android Studio: Importa o abre la carpeta examples/demo-mobile/android\"",
    "ios": "react-native run-ios --port 8082",
    "ios:pod": "cd ios && pod install",
    "ios:clean": "cd ios && rm -rf Pods Podfile.lock build && pod install",
    "ios:xcode": "open ios/SovereignCore.xcworkspace",
    "clean:all": "yarn start:clear && yarn android:clean",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "report": "jest --coverage --coverageReporters=\"html\" --coverageReporters=\"text\" --coverageDirectory=\"coverage\" && eslint src App.tsx --ext .ts,.tsx -f html -o coverage/eslint-report.html",
    "test:check": "node scripts/check_tests.js",
    "lint": "eslint src App.tsx --ext .ts,.tsx",
    "lint:fix": "eslint src App.tsx --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.3.29",
    "@vesper/ghost-ledger": "link:../../packages/ghost-ledger",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.11.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.81.5",
    "react-native-config": "^1.6.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/metro-config": "^0.86.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
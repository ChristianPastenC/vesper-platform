{
  "name": "@vesper-core/ghost-ledger",
  "version": "0.0.1-beta.1",
  "description": "Cryptographic resilience middleware: volatile RAM ledger, Error Trapping Matrix, DPoP asymmetric proof-of-possession signing, and platform-agnostic transport adapters.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dpop": {
      "import": "./dist/dpop/index.js",
      "types": "./dist/dpop/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    }
  },
  "author": "ChristianPastenC <christian_pasten@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianPastenC/vesper-platform.git",
    "directory": "packages/ghost-ledger"
  },
  "bugs": {
    "url": "https://github.com/ChristianPastenC/vesper-platform/issues"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "vesper",
    "ghost-ledger",
    "crypto",
    "dpop"
  ],
  "files": [
    "dist",
    "android",
    "cpp",
    "nitrogen",
    "CMakeLists.txt",
    "nitro.json",
    "SovereignSecureClient.podspec"
  ],
  "scripts": {
    "prepack": "yarn clean:native && yarn codegen && yarn build",
    "clean:native": "rimraf android/build android/.cxx cpp/tests/build",
    "build": "tsc",
    "clean": "rimraf dist",
    "rebuild": "rimraf dist && tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "codegen": "nitrogen",
    "test": "yarn test:js && yarn test:cpp",
    "test:js": "jest",
    "test:cpp": "rimraf build && cmake -S . -B build -DBUILD_TESTING=ON && cmake --build build && cd build && ctest -V"
  },
  "peerDependencies": {
    "react-native-nitro-modules": "*"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nitrogen": "0.35.10",
    "prettier": "^3.3.1",
    "react-native-nitro-modules": "0.35.10",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "rimraf": "^5.0.5"
  }
}
